@using Microsoft.AspNetCore.Mvc.Localization
@model OCPP.Core.Management.Models.MonthlyChargeReportViewModel
@inject IViewLocalizer Localizer

<style>
    .compact-table th, .compact-table td {
        padding: 2px 5px !important;
        margin: 0 !important;
    }
</style>

@{
    ViewData["Title"] = Localizer["Title"];

    // Previous / next month for navigation
    DateTime reported = new DateTime(Model.Year, Model.Month, 1);
    DateTime prev = reported.AddMonths(-1);
    DateTime next = reported.AddMonths(1);
}

<h1>@ViewData["Title"]</h1>
<br />

<div class="container">
    <div class="row">
        <div class="btn-group mb-2 ml-2">
            <a href="@Url.Action("MonthlyChargeReport", new { year = prev.Year, month = prev.Month })" class="btn btn-secondary">&lsaquo; @Localizer["PrevMonth"]</a>
            <a href="@Url.Action("MonthlyChargeReport", new { year = next.Year, month = next.Month })" class="btn btn-secondary">@Localizer["NextMonth"] &rsaquo;</a>
        </div>
    </div>
</div>
<br />

<p>&nbsp;</p>
<div class="container">
    <div class="row">
        <div class="col-sm-10">
            <b>@String.Format(Localizer["ReportTitle"].Value, @Model.StartDate.ToShortDateString(), @Model.StopDate.ToShortDateString())</b>
        </div>
    </div>
</div>

@if (Model.Rows.Count == 0)
{
    <br />
    @Localizer["NoData"]
}
else
{
    <br />
    <table id="dtMonthlyReport" class="table table-striped table-bordered table-sm table-hover" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th class="th-sm">@Localizer["ChargePoint"]</th>
                <th class="th-sm">@Localizer["FirstTag"]</th>
                <th class="th-sm">@Localizer["EnergyDrawn"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.ChargePointName</td>
                    <td>@r.FirstTagName</td>
                    <td>
                        @if (r.SessionActive)
                        {
                            <em>@Localizer["SessionActive"]</em>
                        }
                        else if (r.EnergyKwh.HasValue)
                        {
                            @(Math.Round(r.EnergyKwh.Value, 2)) <text>kWh</text>
                        }
                        else
                        {
                            <em>@Localizer["NoValue"]</em>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
